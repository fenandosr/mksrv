variable "deployment" {
  description = "Decoded deployment.yaml object generated by the mksrv CLI."
  type        = any
}

variable "tenants" {
  description = "Decoded tenant map generated by the mksrv CLI."
  # `map(any)` unifies every element into ONE common type: any tenant missing a
  # key another tenant has (e.g. only one tenant declaring `web:`/`forwards:`)
  # fails with "all map elements must have the same type". An explicit object()
  # with `optional()` attributes lets each tenant's shape genuinely vary. Keep
  # this in sync with internal/model.Tenant's JSON shape.
  type = map(object({
    version      = number
    id           = string
    display_name = string
    base_domain  = string
    dns_override = optional(object({
      provider = string
      zone_id  = optional(string)
      # ADR 0043: mksrv creates and owns the Route 53 zone for base_domain.
      create_zone = optional(bool)
      server      = optional(string)
    }))
    keycloak = object({
      realm = optional(string)
    })
    mail = optional(object({
      domains          = optional(list(string))
      inbound          = optional(bool)
      dmarc_rua        = optional(string)
      hosted           = optional(bool)
      spf_includes     = optional(list(string))
      dmarc_policy     = optional(string)
      dmarc_strict     = optional(bool)
      branded_hostname = optional(bool)
      mailboxes = optional(list(object({
        address = string
        name    = optional(string)
      })))
    }))
    database = optional(object({
      postgrest        = optional(object({ enabled = optional(bool) }))
      schema           = optional(string)
      extensions       = optional(list(string))
      connection_limit = optional(number)
    }))
    stacks = list(string)
    forwards = optional(list(object({
      id            = string
      label         = string
      type          = string
      target        = string
      open          = optional(string)
      path          = optional(string)
      ssh_alias     = optional(string)
      listen_port   = optional(number)
      ssh_user      = optional(string)
      ssh_host_keys = optional(list(string))
    })))
    dns = optional(list(object({
      name  = string
      type  = string
      value = string
      ttl   = optional(number)
    })))
    mesh_routes = optional(list(string))
    web = optional(list(object({
      hostname   = string
      target     = string
      provider   = optional(string)
      cdn        = optional(bool)
      sso        = optional(bool)
      sso_groups = optional(list(string))
    })))
    # Only `s3` is Terraform's business; storage.approles are OpenBao-side
    # (internal/cli/openbao_tenant.go) and are dropped on conversion.
    storage = optional(object({
      s3 = optional(object({
        bucket               = string
        cors_origins         = optional(list(string))
        abort_multipart_days = optional(number)
      }))
    }))
    device_limit = optional(number)
    branding = object({
      primary       = optional(string)
      secondary     = optional(string)
      logo_data_uri = optional(string)
    })
  }))
  default = {}
}

variable "ssh_public_key" {
  description = "Operator SSH public key. When set, an EC2 key pair is created and attached to every host. Injected by the CLI from the workspace or the operator's ~/.ssh."
  type        = string
  default     = ""
}

variable "subnet_count" {
  description = "Public subnet count (one per AZ). The CLI sets 3 when a kind:cluster stack is assigned, 1 otherwise."
  type        = number
  default     = 1
}

variable "host_volumes" {
  description = "Per-host dedicated EBS volumes, aggregated by the CLI from stacks' `storage:` blocks."
  type = map(list(object({
    name       = string
    gb         = number
    iops       = optional(number, 0)
    throughput = optional(number, 0)
    device     = string
    tier       = optional(string, "") # snapshot tier from the stack's storage priority (ADR 0046)
  })))
  default = {}
}

variable "host_data_tier" {
  description = "Per-host snapshot tier of the volume mounted at /var/lib/mksrv: the highest priority among the host's stacks, computed by the CLI (ADR 0046)."
  type        = map(string)
  default     = {}
}

# ADR 0046, phase 1: daily EBS snapshots of every data volume, by tier.
variable "snapshot_enabled" {
  type        = bool
  default     = true
  description = "Create the DLM policies and tag the data volumes. Crash-consistent snapshots, not application-consistent: a database recovers from one as it does from a power cut."
}

variable "snapshot_tiers" {
  description = "Per tier: rpo_hours (how old the newest snapshot may be before the check complains; also the DLM interval, one of 1, 2, 3, 4, 6, 8, 12 or 24) and retain (how many snapshots to keep). The tier of each volume comes from the stack catalog (`priority` in stack.yaml), not from here."
  type = map(object({
    rpo_hours = number
    retain    = number
  }))
  default = {
    critical = { rpo_hours = 24, retain = 30 } # tenant databases, secrets, every tenant's users and mail
    standard = { rpo_hours = 24, retain = 7 }  # host configuration and the rest
    low      = { rpo_hours = 24, retain = 2 }  # metrics and logs, which regenerate
  }

  validation {
    condition     = toset(keys(var.snapshot_tiers)) == toset(["critical", "standard", "low"])
    error_message = "snapshot_tiers must define exactly critical, standard and low."
  }
  validation {
    condition     = alltrue([for t in values(var.snapshot_tiers) : contains([1, 2, 3, 4, 6, 8, 12, 24], t.rpo_hours) && t.retain >= 1 && t.retain <= 1000])
    error_message = "Each tier needs rpo_hours in 1, 2, 3, 4, 6, 8, 12 or 24 (the intervals DLM supports) and retain between 1 and 1000."
  }
}

variable "snapshot_time_utc" {
  type        = string
  default     = "09:00"
  description = "UTC time the daily snapshot starts (HH:MM). The default is 03:00 in Mexico City, away from the restic job."

  validation {
    condition     = can(regex("^([01][0-9]|2[0-3]):[0-5][0-9]$", var.snapshot_time_utc))
    error_message = "snapshot_time_utc must be HH:MM, 24 hour."
  }
}
