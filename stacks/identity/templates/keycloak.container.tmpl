[Unit]
Description=mksrv Keycloak
Requires=mksrv-identity-postgres.service
After=mksrv-identity-postgres.service

[Container]
ContainerName=mksrv-keycloak
Image={{ .Image "keycloak" | default "quay.io/keycloak/keycloak:26.1" }}
Network=mksrv-identity.network
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:9000:9000
# Management port (metrics + health), also on the private IP so a Prometheus
# on another host can scrape it (M23 phase 3).
PublishPort={{ .Host.PrivateIP }}:9000:9000
# One theme directory per declared tenant, sibling to Keycloak's own bundled
# themes (parent=keycloak still resolves) — mksrv apply guarantees each of
# these exists (ensureTenantThemeDirs) even before `tenant apply` has ever
# run for that tenant (M24).
{{- range .TenantIDs }}
Volume=/var/lib/mksrv/stacks/identity/themes/{{ . }}:/opt/keycloak/themes/{{ . }}:Z,ro
{{- end }}
Exec=start --http-enabled=true --hostname=https://{{ .Endpoints.Keycloak }} --proxy-headers=xforwarded
Environment=KC_DB=postgres
Environment=KC_DB_URL=jdbc:postgresql://mksrv-identity-postgres:5432/keycloak
Environment=KC_DB_USERNAME=keycloak
Environment=KC_HEALTH_ENABLED=true
Environment=KC_METRICS_ENABLED=true
Environment=KC_CACHE=local
Environment=KC_HOSTNAME_STRICT=false
Environment=KC_BOOTSTRAP_ADMIN_USERNAME=admin
Secret=mksrv-identity-kc_db_password,type=env,target=KC_DB_PASSWORD
Secret=mksrv-identity-keycloak_admin_password,type=env,target=KC_BOOTSTRAP_ADMIN_PASSWORD

[Service]
Restart=always
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
