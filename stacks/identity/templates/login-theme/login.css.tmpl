/* stacks/identity/templates/login-theme/login.css.tmpl
   Rendered by mksrv for tenant {{ .Tenant.ID }} (M24, ADR 0023).
   CSS only — the login page's FreeMarker templates are untouched, so this
   survives Keycloak upgrades. Selectors target keycloak.v2 (PatternFly v5),
   verified against a live login page. */

:root {
  --mksrv-primary: {{ .Tenant.Branding.Primary | default "#0C6D77" }};
  --mksrv-secondary: {{ .Tenant.Branding.Secondary | default (.Tenant.Branding.Primary | default "#0C6D77") }};

  --mksrv-glass-blur: 9px;
  --mksrv-glass-tint: rgba(255, 255, 255, 0.07);
  --mksrv-glass-stroke: rgba(255, 255, 255, 0.22);
  --mksrv-glass-radius: 9px;
  --mksrv-scrim: 0.76;
  --mksrv-on-glass: #ffffff;
  --mksrv-on-glass-dim: rgba(255, 255, 255, 0.72);
}

/* ---- background: the two brand colours, blended, with a dark scrim so
   text on the glass stays legible whatever the two hues are ---- */
body#keycloak-bg,
.login-pf body {
  background-color: #0b0d12;
  background-image: linear-gradient(135deg, var(--mksrv-primary), var(--mksrv-secondary));
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}
@supports (background: color-mix(in oklab, white, black)) {
  body#keycloak-bg,
  .login-pf body {
    background-image:
      radial-gradient(ellipse at 12% 12%, color-mix(in oklab, var(--mksrv-secondary) 68%, transparent), transparent 58%),
      radial-gradient(ellipse at 88% 84%, color-mix(in oklab, var(--mksrv-primary) 78%, transparent), transparent 58%),
      linear-gradient(135deg,
        color-mix(in oklab, var(--mksrv-primary) 92%, black),
        color-mix(in oklab, var(--mksrv-secondary) 86%, black));
  }
}
.pf-v5-c-login::before {
  content: "";
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse at 50% 24%, transparent, rgba(0, 0, 0, 0.34)),
    rgba(4, 6, 10, var(--mksrv-scrim));
  pointer-events: none;
}
.pf-v5-c-login__container { position: relative; z-index: 1; }

/* ---- header / logo ---- */
#kc-header-wrapper {
  color: var(--mksrv-on-glass) !important;
  text-transform: none;
  letter-spacing: 0.04em;
  font-weight: 500;
  padding: 4px 0 2px;
}
{{- if .Tenant.Branding.LogoDataURI }}
#kc-header-wrapper {
  height: 78px;
  background-image: url("{{ .Tenant.Branding.LogoDataURI }}");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.45));
  text-indent: -9999px;
  white-space: nowrap;
  overflow: hidden;
}
{{- end }}

/* ---- the glass card ---- */
.pf-v5-c-login__main {
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.03) 46%),
    var(--mksrv-glass-tint);
  backdrop-filter: blur(var(--mksrv-glass-blur)) saturate(160%);
  -webkit-backdrop-filter: blur(var(--mksrv-glass-blur)) saturate(160%);
  border: 1px solid var(--mksrv-glass-stroke);
  border-radius: var(--mksrv-glass-radius);
  box-shadow:
    0 24px 70px -20px rgba(0, 0, 0, 0.6),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .pf-v5-c-login__main { background: rgba(20, 23, 30, 0.92); }
}
@media (prefers-reduced-motion: no-preference) {
  .pf-v5-c-login__main { animation: mksrv-rise 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
  @keyframes mksrv-rise { from { opacity: 0; transform: translateY(14px) scale(0.985); } }
}

/* ---- text inside the card goes light ---- */
#kc-page-title { color: var(--mksrv-on-glass); }
.pf-v5-c-form__label-text,
.pf-v5-c-helper-text__item-text,
#kc-info-wrapper { color: var(--mksrv-on-glass-dim); }
.pf-v5-c-login__main a:not(.pf-v5-c-button) {
  color: var(--mksrv-on-glass);
  text-underline-offset: 3px;
  text-decoration-color: color-mix(in oklab, var(--mksrv-secondary) 70%, white);
}
.pf-v5-c-login__main a:not(.pf-v5-c-button):hover { text-decoration-color: var(--mksrv-on-glass); }
#kc-info { border-top-color: rgba(255, 255, 255, 0.14); }

/* ---- inputs ---- */
.pf-v5-c-form-control {
  background: rgba(255, 255, 255, 0.10);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 10px;
  box-shadow: none;
  transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
}
.pf-v5-c-form-control::after { display: none; }
.pf-v5-c-form-control,
.pf-v5-c-form-control input { color: var(--mksrv-on-glass); }
.pf-v5-c-form-control input::placeholder { color: rgba(255, 255, 255, 0.45); }
.pf-v5-c-form-control:focus-within {
  background: rgba(255, 255, 255, 0.14);
  border-color: var(--mksrv-secondary);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--mksrv-secondary) 32%, transparent);
}
.pf-v5-c-input-group,
.pf-v5-c-input-group__item { background: transparent; border: 0; }
.pf-v5-c-input-group .pf-v5-c-form-control { border-radius: 10px 0 0 10px; }
.pf-v5-c-button.pf-m-control {
  background: rgba(255, 255, 255, 0.10);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-left: 0;
  border-radius: 0 10px 10px 0;
  color: var(--mksrv-on-glass-dim);
}

/* ---- primary button: mostly the CTA colour, with a secondary-colour sheen ---- */
.pf-v5-c-button.pf-m-primary {
  background-color: var(--mksrv-primary);
  background-image: linear-gradient(135deg, transparent 35%, color-mix(in oklab, var(--mksrv-secondary) 55%, transparent));
  border: 0;
  border-radius: 10px;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.28);
  box-shadow: 0 10px 30px -10px color-mix(in oklab, var(--mksrv-primary) 55%, transparent);
  transition: transform 0.14s ease, box-shadow 0.14s ease, filter 0.14s ease;
}
.pf-v5-c-button.pf-m-primary:hover {
  filter: brightness(1.06);
  transform: translateY(-1px);
  box-shadow: 0 16px 40px -12px color-mix(in oklab, var(--mksrv-primary) 65%, transparent);
}
.pf-v5-c-button.pf-m-primary:active { transform: translateY(0); }

/* ---- secondary / ghost button ---- */
.pf-v5-c-button.pf-m-secondary {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.30);
  border-radius: 10px;
  color: var(--mksrv-on-glass);
}
.pf-v5-c-button.pf-m-secondary:hover { background: rgba(255, 255, 255, 0.16); }

/* ---- alerts (error / info banners above the form) ---- */
.pf-v5-c-alert {
  background: rgba(255, 255, 255, 0.10);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.20);
  border-radius: 12px;
  color: var(--mksrv-on-glass);
}
.pf-v5-c-alert__title { color: var(--mksrv-on-glass); }
.pf-v5-c-form__helper-text.pf-m-error,
.pf-v5-c-helper-text__item.pf-m-error .pf-v5-c-helper-text__item-text { color: #ff9a9a; }
