[Unit]
Description=mksrv backup (restic)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Invoke bash explicitly: the script lives under /var/lib/mksrv, which the
# bootstrap relabels for podman's graphroot, so systemd (init_t) cannot exec
# the file directly — it can exec bash and let bash read the script.
ExecStart=/usr/bin/bash /var/lib/mksrv/stacks/backup/backup.sh
TimeoutStartSec=3600
