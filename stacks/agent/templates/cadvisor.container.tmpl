[Unit]
Description=mksrv cAdvisor

[Container]
ContainerName=mksrv-cadvisor
Image={{ .Image "cadvisor" | default "gcr.io/cadvisor/cadvisor:v0.49.2" }}
Network=mksrv-agent.network
# 8080 is a very common default (Keycloak binds it on 127.0.0.1 too, and
# `agent` now runs on every host including `identity`'s) — publish only on
# the private IP, which Prometheus already uses to scrape cross-host; no
# 127.0.0.1 publish to collide with.
PublishPort={{ .Host.PrivateIP }}:8080:8080
Volume=/:/rootfs:ro
Volume=/var/run:/var/run:ro
Volume=/sys:/sys:ro
Volume=/var/lib/containers:/var/lib/containers:ro
Volume=/dev/disk:/dev/disk:ro
PodmanArgs=--privileged --device=/dev/kmsg

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
