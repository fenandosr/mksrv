[Unit]
Description=mksrv tenant-local mesh node ({{ .InstanceName }})
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mesh-{{ .InstanceName }}
Image={{ .Image "tailscale" }}
AddCapability=NET_ADMIN
AddCapability=NET_RAW
AddDevice=/dev/net/tun
# Same SELinux confinement issue documented for the cloud tailscale unit
# (internal/deploy/scripts/tailscale.container.tmpl): container_t denies the
# tun_socket class needed for a real kernel TUN device. Harmless on a
# non-SELinux host (e.g. WSL2).
SecurityLabelDisable=true
Environment=TS_STATE_DIR=/var/lib/tailscale
Environment=TS_USERSPACE=false
Environment=TS_ACCEPT_DNS=false
Environment=TS_HOSTNAME={{ .Env }}-{{ .LocalHostName }}-{{ .InstanceName }}
Environment="TS_EXTRA_ARGS=--login-server=https://{{ .Endpoints.Headscale }}"
# A bare `Environment=TS_AUTHKEY` (no "=value", relying on podman passing
# through whatever the invoking process's own environment holds for that
# name) does NOT work: confirmed live against quadlet 4.9.3 — its generated
# ExecStart= only ever emits `--env` for lines that already contain "=";
# anything else is silently dropped, so the key never reaches the
# container at all. A podman Secret is the one mechanism that actually
# injects a value `mksrv mesh` sets later, after this unit already exists —
# the same shape the cloud tailscale unit uses (internal/deploy/mesh.go),
# just one secret per local instance instead of one shared by the whole
# fleet. `mksrv deploy` creates it empty on first deploy (so the container
# can start at all, unauthenticated); `mksrv mesh` --replaces it with a real
# pre-auth key and restarts.
Secret=mksrv-meshnode-{{ .InstanceName }}-authkey,type=env,target=TS_AUTHKEY
Volume=mksrv-mesh-{{ .InstanceName }}-state:/var/lib/tailscale

[Service]
DeviceAllow=/dev/net/tun rwm
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
