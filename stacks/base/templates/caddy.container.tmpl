[Unit]
Description=mksrv Caddy edge proxy
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mksrv-caddy
Image={{ .Image "caddy" | default "docker.io/library/caddy:2.8" }}
# Host networking so the proxy can reach every stack's host-published port on
# 127.0.0.1 and bind 80/443/443udp directly.
Network=host
Volume=/var/lib/mksrv/stacks/base/Caddyfile:/etc/caddy/Caddyfile:Z,ro
Volume=/var/lib/mksrv/caddy.d:/etc/caddy/caddy.d:Z,ro
Volume=mksrv-caddy-data:/data
Volume=mksrv-caddy-config:/config

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target default.target
