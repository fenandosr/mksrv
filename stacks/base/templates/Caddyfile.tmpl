{
	admin 127.0.0.1:2019
	email {{ .ACMEEmail }}
	servers {
		metrics
	}
	log {
		output stdout
		format json
	}
}

# Plain-HTTP health endpoint, reachable by IP for load-balancer style checks.
:80 {
	respond /healthz "ok" 200
	respond "mksrv {{ .Env }} edge" 200
}

# Prometheus scrapes Caddy through here rather than the admin API directly:
# the admin listener (config reload, /stop, ...) stays loopback-only, and only
# /metrics is proxied through, on the private IP (M23 phase 3).
# `http://` is required: a site address that is a bare IP makes Caddy serve HTTPS (its internal CA)
# on that port, and Prometheus scrapes over plain HTTP, so every scrape got
# "Client sent an HTTP request to an HTTPS server" (400) once the firewall let it in.
http://{{ .Host.PrivateIP }}:9019 {
	handle /metrics {
		# The admin API only accepts requests whose Host is its own address; reverse_proxy forwards
		# the client's (<private ip>:9019), which the admin API answers with 403.
		reverse_proxy 127.0.0.1:2019 {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		respond 404
	}
}

# Per-stack reverse-proxy vhosts (identity, monitor, tenant services) drop
# fragments here as they are deployed on the edge. An empty glob is not an error.
import /etc/caddy/caddy.d/*.caddy
