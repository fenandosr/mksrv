[Unit]
Description=mksrv PostgREST ({{ .Tenant.ID }})
{{- if not (.StackIP "postgres") }}
Requires=mksrv-postgres.service
After=mksrv-postgres.service
{{- end }}

[Container]
ContainerName=mksrv-postgrest-{{ .Tenant.ID }}
Image={{ .Image "postgrest" | default "docker.io/postgrest/postgrest:v12.2.3" }}
Network=mksrv-database.network
# Reachable by the edge over the VPC and by tenant devices over the tailnet;
# the container always listens on 3000 inside its netns.
PublishPort={{ .Host.PrivateIP }}:{{ .Secrets.listen_port }}:3000
{{- if .Host.TailnetIP }}
PublishPort={{ .Host.TailnetIP }}:{{ .Secrets.listen_port }}:3000
{{- end }}
PublishPort=127.0.0.1:{{ .Secrets.listen_port }}:3000
Environment=PGRST_DB_SCHEMAS={{ join .Tenant.PostgRESTSchemas "," }}
# Global RBAC buckets (ADR 0026); the connection is still per-tenant (db_<id> as
# <id>_auth), so mksrv_anon in this container only ever sees this tenant's data.
# mksrv_anon gets no blanket SELECT — the tenant grants anon access per table
# for exactly what it wants public (ADR 0029).
Environment=PGRST_DB_ANON_ROLE=mksrv_anon
Environment=PGRST_DB_POOL=4
Environment=PGRST_DB_CONFIG=false
Environment=PGRST_SERVER_PORT=3000
Environment=PGRST_JWT_ROLE_CLAIM_KEY=.role
# db-pre-request narrows mksrv_web to mksrv_owner / mksrv_app / mksrv_anon by the token's RBAC groups.
# ADR 0039: the generated pre-request lives in the non-exposed mksrv schema.
Environment=PGRST_DB_PRE_REQUEST=mksrv.pgrst_pre_request
Environment=PGRST_APP_SETTINGS_OIDC_ISSUER={{ .Secrets.oidc_issuer }}
{{- with .Tenant.PostgRESTSettings }}
{{- if .JWTAudience }}
Environment=PGRST_JWT_AUD={{ .JWTAudience }}
{{- end }}
{{- if .CORSOrigins }}
Environment=PGRST_SERVER_CORS_ALLOWED_ORIGINS={{ join .CORSOrigins "," }}
{{- end }}
{{- if .MaxRows }}
Environment=PGRST_DB_MAX_ROWS={{ .MaxRows }}
{{- end }}
{{- end }}
Environment=PGRST_OPENAPI_SERVER_PROXY_URI=https://{{ .Secrets.rest_fqdn }}
Secret=mksrv-database-postgrest-{{ .Tenant.ID }}-dburi,type=env,target=PGRST_DB_URI
Secret=mksrv-database-postgrest-{{ .Tenant.ID }}-jwt,type=env,target=PGRST_JWT_SECRET

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
