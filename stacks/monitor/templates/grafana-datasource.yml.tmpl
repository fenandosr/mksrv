apiVersion: 1
datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://mksrv-prometheus:9090
    isDefault: true
    editable: false
{{- if .StackIP "logs" }}
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://{{ .StackIP "logs" }}:3100
    editable: false
{{- end }}
