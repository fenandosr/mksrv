global:
  scrape_interval: 30s
  external_labels:
    env: {{ .Env }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # The fleet's `agent` stack (node-exporter + cAdvisor), published on every
  # host's private VPC IP — no mesh hop needed, hosts already trust each
  # other inside the VPC (M23).
  - job_name: node
    static_configs:
{{- range .Fleet }}
      - targets: ["{{ .PrivateIP }}:9100"]
        labels: { host: "{{ .Name }}", role: "{{ .Role }}" }
{{- end }}

  - job_name: cadvisor
    static_configs:
{{- range .Fleet }}
      - targets: ["{{ .PrivateIP }}:8080"]
        labels: { host: "{{ .Name }}", role: "{{ .Role }}" }
{{- end }}

{{- if .StackNodes "postgres" }}

  # Patroni serves its own /metrics natively — no exporter needed.
  - job_name: patroni
    static_configs:
{{- range .StackNodes "postgres" }}
      - targets: ["{{ .PrivateIP }}:8008"]
        labels: { host: "{{ .Name }}" }
{{- end }}

  # postgres_exporter runs alongside Patroni on every cluster node (M23 phase 2).
  - job_name: postgres-exporter
    static_configs:
{{- range .StackNodes "postgres" }}
      - targets: ["{{ .PrivateIP }}:9187"]
        labels: { host: "{{ .Name }}" }
{{- end }}
{{- end }}
{{- if .StackNodes "openbao" }}

  # OpenBao's own Prometheus telemetry (unauthenticated on the VPC — M23 phase 2).
  - job_name: openbao
    metrics_path: /v1/sys/metrics
    params:
      format: [prometheus]
    static_configs:
{{- range .StackNodes "openbao" }}
      - targets: ["{{ .PrivateIP }}:8200"]
        labels: { host: "{{ .Name }}" }
{{- end }}
{{- end }}
{{- if .StackIP "cache" }}

  - job_name: redis-exporter
    static_configs:
      - targets: ["{{ .StackIP "cache" }}:9121"]
{{- end }}
{{- if .StackIP "logs" }}

  - job_name: loki
    static_configs:
      - targets: ["{{ .StackIP "logs" }}:3100"]
{{- end }}
{{- if .StackIP "security" }}

  - job_name: crowdsec
    static_configs:
      - targets: ["{{ .StackIP "security" }}:6060"]
{{- end }}
