[Unit]
Description=mksrv Prometheus

[Container]
ContainerName=mksrv-prometheus
Image={{ .Image "prometheus" | default "quay.io/prometheus/prometheus:v3.1.0" }}
Network=mksrv-monitor.network
PublishPort=127.0.0.1:9090:9090
Volume=/var/lib/mksrv/stacks/monitor/prometheus.yml:/etc/prometheus/prometheus.yml:Z,ro
Volume=mksrv-monitor-prometheus:/prometheus
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.retention.time=15d --web.enable-lifecycle

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
