[Unit]
Description=mksrv Loki

[Container]
ContainerName=mksrv-loki
Image={{ .Image "loki" | default "docker.io/grafana/loki:3.4.2" }}
Network=mksrv-logs.network
PublishPort={{ .Host.PrivateIP }}:3100:3100
{{- if .Host.TailnetIP }}
PublishPort={{ .Host.TailnetIP }}:3100:3100
{{- end }}
PublishPort=127.0.0.1:3100:3100
Volume=/var/lib/mksrv/stacks/logs/loki.yml:/etc/loki/loki.yml:Z,ro
Volume={{ .Volume "chunks" }}:/loki:Z
Exec=-config.file=/etc/loki/loki.yml
HealthCmd=wget -q -O /dev/null http://127.0.0.1:3100/ready
HealthInterval=15s
HealthRetries=10
HealthStartPeriod=20s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
