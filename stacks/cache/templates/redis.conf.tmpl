# Rendered by mksrv. Per-tenant ACL users live in acl/users.acl, which
# `mksrv tenant apply` rewrites and reloads (ACL LOAD). The directory (not the
# file) is bind-mounted: WriteFileSudo replaces the file by atomic rename, so a
# single-file mount would pin the container to the original inode and ACL LOAD
# would keep reading a stale file.
aclfile /etc/redis/acl/users.acl

appendonly yes
appendfsync everysec
dir /data
save ""

maxmemory 256mb
maxmemory-policy allkeys-lru

# Binds are the private VPC IP, the tailnet IP, and loopback; every client
# authenticates as an ACL user, so protected-mode would only get in the way.
protected-mode no
