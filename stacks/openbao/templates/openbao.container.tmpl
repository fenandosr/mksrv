[Unit]
Description=mksrv OpenBao node
Wants=network-online.target
After=network-online.target mksrv-tailscale.service

[Container]
ContainerName=mksrv-openbao
Image={{ .Image "openbao" | default "ghcr.io/openbao/openbao:2.6.1" }}
# Host networking (ADR 0042): a published port is DNAT'd, and tailscaled's own
# `ts-postrouting` MASQUERADE rewrites every tailnet client's source to the
# podman bridge gateway, which makes CIDR-bound AppRoles unusable and blinds the
# audit log. The listeners bind explicit addresses (openbao.hcl); firewall.sh
# opens exactly those ports to exactly the fleet and the tailnet.
Network=host
AddCapability=IPC_LOCK
Environment=BAO_ADDR=http://127.0.0.1:8200
Exec=server -config=/openbao/config/openbao.hcl
Volume=/var/lib/mksrv/stacks/openbao/openbao.hcl:/openbao/config/openbao.hcl:Z,ro
Volume={{ .Volume "baoraft" }}:/openbao/data:Z,U
HealthCmd=sh -c 'bao status; test $? -ne 1'
HealthInterval=30s
HealthRetries=10
HealthStartPeriod=15s

[Service]
# Open the API/Raft ports in firewalld before the container binds them (host
# networking bypasses the FORWARD-chain shortcut a published port had).
ExecStartPre=/usr/bin/bash /var/lib/mksrv/stacks/openbao/firewall.sh
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
