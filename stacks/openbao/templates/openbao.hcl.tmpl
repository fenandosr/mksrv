# Rendered by mksrv, one per cluster node. Storage = Integrated Storage (Raft) —
# the OpenBao nodes reach consensus among themselves, no external etcd/consul.
# Auto-unseal is delegated to AWS KMS; the instance profile carries the
# kms:Encrypt/Decrypt grant. The listener is plaintext: confidentiality is the
# mesh and the intra-VPC security group, the same boundary as Patroni (ADR 0005).

ui = true

storage "raft" {
  path    = "/openbao/data"
  node_id = "{{ .Host.Name }}"
{{- range .StackNodes "openbao" }}
  retry_join {
    leader_api_addr = "http://{{ .PrivateIP }}:8200"
  }
{{- end }}
}

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = 1
  # /v1/sys/metrics without a token — acceptable on the same intra-VPC
  # boundary that already makes the rest of this listener plaintext (M23
  # phase 2); Prometheus has no other way to reach a scoped metrics token.
  telemetry {
    unauthenticated_metrics_access = true
  }
}

telemetry {
  prometheus_retention_time = "24h"
  disable_hostname          = true
}

seal "awskms" {
  region     = "{{ .Region }}"
  kms_key_id = "{{ .OpenBaoKMSKeyID }}"
}

api_addr     = "http://{{ .Host.PrivateIP }}:8200"
cluster_addr = "http://{{ .Host.PrivateIP }}:8201"
