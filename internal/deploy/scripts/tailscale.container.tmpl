[Unit]
Description=mksrv tailnet node
Wants=network-online.target
After=network-online.target
# A start-rate limit, not a behavior change: a restart storm here (bad
# authkey, Headscale unreachable, whatever) would otherwise retry as fast as
# systemd allows, hammering Headscale with a fresh RegisterReq per attempt —
# confirmed as a real failure mode for the sibling tenant-local meshnode unit
# (stacks/meshnode/templates/mesh.container.tmpl), which shares this same
# Secret-based TS_AUTHKEY / TS_EXTRA_ARGS shape.
StartLimitIntervalSec=600
StartLimitBurst=5

[Container]
ContainerName=mksrv-tailscale
Image={{ .Image }}
Network=host
AddCapability=NET_ADMIN
AddCapability=NET_RAW
AddDevice=/dev/net/tun
# RHEL/Rocky's container-selinux policy confines Podman containers as
# container_t, which denies the "tun_socket" object class (create/ioctl on
# /dev/net/tun) needed to bring up a real kernel TUN device -- surfaces as
# tstun.New(...): permission denied (EACCES on TUNSETIFF), even with
# NET_ADMIN/NET_RAW and correct DAC perms on the device node, and even though
# the denial is marked dontaudit so it never shows up in `ausearch` (confirmed
# live, prod edge, 2026-09-12). Disabling SELinux labeling for just this
# container is Podman's documented fix for tun/tap-in-container on SELinux
# hosts; it does not affect confinement of any other container.
SecurityLabelDisable=true
Environment=TS_STATE_DIR=/var/lib/tailscale
Environment=TS_USERSPACE=false
Environment=TS_ACCEPT_DNS=false
Environment=TS_HOSTNAME={{ .Hostname }}
# Quoted: systemd's Environment= splits an unquoted value on whitespace as if
# it were several NAME=value assignments, so an unquoted multi-word value here
# silently turned "--accept-routes" into its own bogus `--env --accept-routes`
# podman arg (confirmed live via `systemctl show -p ExecStart`) -- meaning
# --accept-routes was never actually reaching tailscaled.
Environment="TS_EXTRA_ARGS=--login-server={{ .LoginServer }} --accept-routes"
Secret=mksrv-mesh-authkey,type=env,target=TS_AUTHKEY
Volume=mksrv-tailscale-state:/var/lib/tailscale

[Service]
DeviceAllow=/dev/net/tun rwm
Restart=always
RestartSec=30s
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
