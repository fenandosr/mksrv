#!/usr/bin/env bash
# mksrv host bootstrap. Idempotent and marker-guarded: safe to re-run.
# Rendered by internal/deploy; do not run by hand.
set -euo pipefail

MARKER_DIR=/var/lib/mksrv
MARKER="$MARKER_DIR/.bootstrap-v{{ .MarkerVersion }}"
IS_EDGE={{ if .IsEdge }}1{{ else }}0{{ end }}
TIMEZONE="{{ .Timezone }}"

log() { printf '[mksrv-bootstrap] %s\n' "$*"; }

# Echo the /dev path of the NVMe disk whose EBS volume id matches $1 (Nitro
# instances expose the volume id, dashes stripped, as the controller serial).
mksrv_disk_by_serial() {
  local want serial dev
  want="$(printf '%s' "$1" | tr -dc 'A-Za-z0-9')"
  for dev in /dev/nvme*n1; do
    [ -e "$dev" ] || continue
    serial="$(cat "/sys/block/$(basename "$dev")/device/serial" 2>/dev/null | tr -dc 'A-Za-z0-9')"
    [ "$serial" = "$want" ] && { printf '%s' "$dev"; return 0; }
  done
  return 1
}

# Format (if blank) and fstab-mount $1 at $2.
mksrv_mount_xfs() {
  local dev="$1" mnt="$2" uuid
  blkid "$dev" >/dev/null 2>&1 || { log "formatting $dev as xfs"; mkfs.xfs -q "$dev"; }
  mkdir -p "$mnt"
  uuid="$(blkid -s UUID -o value "$dev")"
  grep -q "$uuid" /etc/fstab || echo "UUID=$uuid $mnt xfs defaults,noatime 0 2" >>/etc/fstab
  systemctl daemon-reload
  mount "$mnt"
  log "mounted $dev ($uuid) at $mnt"
}

if [ "$(id -u)" -ne 0 ]; then
  echo "bootstrap must run as root" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# 1. Data volume -> /var/lib/mksrv
# ---------------------------------------------------------------------------
if ! mountpoint -q "$MARKER_DIR"; then
  data_dev=""
{{- if .DataVolumeID }}
  data_dev="$(mksrv_disk_by_serial '{{ .DataVolumeID }}' || true)"
{{- end }}
  if [ -z "$data_dev" ]; then
    root_disk="$(lsblk -ndo PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null || true)"
    while read -r name type mnt; do
      [ "$type" = "disk" ] || continue
      [ "$name" = "$root_disk" ] && continue
      [ -n "$mnt" ] && continue
      # skip disks that already hold partitions
      if lsblk -nro NAME,TYPE "/dev/$name" | awk '$2=="part"{f=1} END{exit !f}'; then
        continue
      fi
      data_dev="/dev/$name"
      break
    done < <(lsblk -nro NAME,TYPE,MOUNTPOINT)
  fi

  if [ -n "$data_dev" ]; then
    mksrv_mount_xfs "$data_dev" "$MARKER_DIR"
  else
    log "no separate data volume found; using root filesystem for $MARKER_DIR"
    mkdir -p "$MARKER_DIR"
  fi
fi
mkdir -p "$MARKER_DIR/containers" "$MARKER_DIR/stacks"

# ---------------------------------------------------------------------------
# 1b. Swap -> /swapfile, sized to the host's stack set (reconciled every run)
# ---------------------------------------------------------------------------
TARGET_SWAP_MB={{ .SwapMB }}
current_swap_mb=$(( $(stat -c %s /swapfile 2>/dev/null || echo 0) / 1048576 ))
if [ "$TARGET_SWAP_MB" -gt 0 ] && [ "$current_swap_mb" != "$TARGET_SWAP_MB" ]; then
  log "resizing swap: ${current_swap_mb}M -> ${TARGET_SWAP_MB}M"
  swapoff /swapfile 2>/dev/null || true
  rm -f /swapfile
  fallocate -l "${TARGET_SWAP_MB}M" /swapfile || dd if=/dev/zero of=/swapfile bs=1M count="$TARGET_SWAP_MB" status=none
  chmod 600 /swapfile
  mkswap -q /swapfile
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab
  echo 'vm.swappiness=10' >/etc/sysctl.d/90-mksrv-swap.conf
  sysctl -q -w vm.swappiness=10
elif [ "$TARGET_SWAP_MB" -eq 0 ] && [ -e /swapfile ]; then
  log "removing swap"
  swapoff /swapfile 2>/dev/null || true
  rm -f /swapfile
  sed -i '\#^/swapfile #d' /etc/fstab
fi

# ---------------------------------------------------------------------------
# 1c. Dedicated stack volumes -> /var/lib/mksrv/vol/<name>
# ---------------------------------------------------------------------------
{{- range .Volumes }}
vdev="$(mksrv_disk_by_serial '{{ .VolumeID }}' || true)"
if [ -n "$vdev" ] && ! mountpoint -q "$MARKER_DIR/vol/{{ .Name }}"; then
  mksrv_mount_xfs "$vdev" "$MARKER_DIR/vol/{{ .Name }}"
elif [ -z "$vdev" ]; then
  log "volume {{ .Name }} ({{ .VolumeID }}) is not attached yet; skipping"
fi
{{- end }}

if [ -f "$MARKER" ]; then
  log "already bootstrapped ($MARKER); nothing to do"
  exit 0
fi

# ---------------------------------------------------------------------------
# 2. Packages
# ---------------------------------------------------------------------------
log "installing packages"
dnf -y -q install \
  podman podman-plugins container-selinux \
  firewalld chrony \
  policycoreutils-python-utils python3-libselinux \
  tar rsync

# ---------------------------------------------------------------------------
# 3. Time
# ---------------------------------------------------------------------------
timedatectl set-timezone "$TIMEZONE" || true
systemctl enable --now chronyd

# ---------------------------------------------------------------------------
# 4. SELinux enforcing
# ---------------------------------------------------------------------------
setenforce 1 || true
sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config

# ---------------------------------------------------------------------------
# 5. firewalld
# ---------------------------------------------------------------------------
systemctl enable --now firewalld
firewall-cmd --set-default-zone=public >/dev/null
firewall-cmd --permanent --zone=public --add-service=ssh >/dev/null
if [ "$IS_EDGE" = "1" ]; then
  firewall-cmd --permanent --zone=public --add-service=http >/dev/null
  firewall-cmd --permanent --zone=public --add-service=https >/dev/null
fi
firewall-cmd --reload >/dev/null

# ---------------------------------------------------------------------------
# 6. Podman storage on the data volume + Quadlet
# ---------------------------------------------------------------------------
GRAPHROOT="$MARKER_DIR/containers"
install -d -m 0755 /etc/containers
cat >/etc/containers/storage.conf <<EOF
[storage]
driver = "overlay"
graphroot = "$GRAPHROOT"
runroot = "/run/containers/storage"
EOF
install -d -m 0755 /etc/containers/systemd

# Send container stdout/stderr to the systemd journal so a log collector
# (Grafana Alloy) and CrowdSec can read every container's output by unit /
# CONTAINER_NAME without a per-container log-driver override.
cat >/etc/containers/containers.conf <<EOF
[containers]
log_driver = "journald"
EOF

# Persistent journal so log/security collectors survive reboots and read from a
# stable path.
install -d -m 2755 -g systemd-journal /var/log/journal 2>/dev/null || install -d -m 2755 /var/log/journal
systemd-tmpfiles --create --prefix /var/log/journal 2>/dev/null || true
systemctl restart systemd-journald || true

# The relocated graphroot must carry the same SELinux labelling as the default
# podman graphroot (/var/lib/containers/storage), or container processes fail
# with "cannot change memory protections" and volume writes are denied.
if command -v semanage >/dev/null 2>&1; then
  semanage fcontext -d -e /var/lib/containers "$GRAPHROOT" 2>/dev/null || true
  if ! semanage fcontext -l 2>/dev/null | awk -v p="$GRAPHROOT" '$1==p{f=1} END{exit !f}'; then
    semanage fcontext -a -e /var/lib/containers/storage "$GRAPHROOT"
  fi
fi
restorecon -RF "$GRAPHROOT" 2>/dev/null || true

systemctl enable --now podman.socket
systemctl enable podman-auto-update.timer || true

# ---------------------------------------------------------------------------
# 7. Kernel modules and sysctl tuning
# ---------------------------------------------------------------------------
# tun + netfilter modules are needed by the tailnet node container.
for mod in tun iptable_filter iptable_nat ip6table_filter nf_nat; do
  modprobe "$mod" 2>/dev/null || true
done
printf '%s\n' tun iptable_filter iptable_nat ip6table_filter nf_nat >/etc/modules-load.d/mksrv-mesh.conf

cat >/etc/sysctl.d/90-mksrv.conf <<EOF
net.core.somaxconn = 1024
net.ipv4.ip_unprivileged_port_start = 80
vm.max_map_count = 262144
fs.inotify.max_user_instances = 512
EOF
sysctl -q --system

# ---------------------------------------------------------------------------
# 8. Quiet stock services that fail on EC2, and no unattended reboots
# ---------------------------------------------------------------------------
systemctl mask --now dnf-automatic-install.timer 2>/dev/null || true
# rngd has no hardware RNG on most EC2 instance types; the kernel CSPRNG is used.
systemctl mask --now rngd.service 2>/dev/null || true
systemctl reset-failed 2>/dev/null || true

printf 'bootstrapped %s on %s\n' "v{{ .MarkerVersion }}" "$(date -u +%FT%TZ)" >"$MARKER"
log "bootstrap complete"
